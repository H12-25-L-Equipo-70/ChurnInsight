# 🐳 Environment variables para Docker
# Copiar a .env.docker antes de ejecutar docker-compose

# === AI SERVICE ===
ENVIRONMENT=docker
DEBUG=false
LOG_LEVEL=INFO

# === BACKEND ===
SPRING_PROFILES_ACTIVE=docker

# === ORACLE (opcional - solo si connects to Oracle Cloud) ===
# ORACLE_USER=pymerdb
# ORACLE_PASSWORD=your_password_here
# ORACLE_HOST=pymerdb.sa-saopaulo-1.oraclecloud.com
# ORACLE_PORT=1522
# ORACLE_SERVICE_NAME=pymerdb_high
# ORACLE_WALLET_PATH=/app/wallet_pymer

# === CONFIGURACIÓN GENERAL ===
TZ=America/Argentina/Buenos_Aires
